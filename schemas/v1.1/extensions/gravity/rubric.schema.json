{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-formation-benchmark.org/schemas/v1.1/extensions/gravity/rubric.schema.json",
  "title": "Gravity construct rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "construct", "version", "operational_definition",
    "positive_indicators", "negative_indicators", "subtle_failures",
    "contraindications", "cultural_accessibility_caveats", "minimal_pairs",
    "evidence_requirements", "not_applicable_rule", "insufficient_evidence_rule",
    "source_mapping", "score_anchors", "changelog"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "id": {"type": "string", "pattern": "^gravity\\.[a-z0-9_]+$"},
    "construct": {"type": "string"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "operational_definition": {"type": "string"},
    "positive_indicators": {"$ref": "#/$defs/nonemptyList"},
    "negative_indicators": {"$ref": "#/$defs/nonemptyList"},
    "subtle_failures": {"$ref": "#/$defs/nonemptyList"},
    "contraindications": {"$ref": "#/$defs/nonemptyList"},
    "cultural_accessibility_caveats": {"$ref": "#/$defs/nonemptyList"},
    "minimal_pairs": {"$ref": "#/$defs/nonemptyList"},
    "evidence_requirements": {"$ref": "#/$defs/nonemptyList"},
    "not_applicable_rule": {"type": "string"},
    "insufficient_evidence_rule": {"type": "string"},
    "source_mapping": {"$ref": "#/$defs/nonemptyList"},
    "score_anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3", "4"],
      "properties": {
        "0": {"type": "string"}, "1": {"type": "string"}, "2": {"type": "string"},
        "3": {"type": "string"}, "4": {"type": "string"}
      }
    },
    "changelog": {"$ref": "#/$defs/nonemptyList"}
  },
  "$defs": {
    "nonemptyList": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
