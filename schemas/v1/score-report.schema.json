{
  "$defs": {
    "Dimension": {
      "enum": [
        "truth_epistemic_integrity",
        "intellectual_humility",
        "agency_support",
        "competence_retention",
        "human_relatedness",
        "dependency_boundary_quality",
        "reality_contact",
        "moral_responsibility",
        "empathy_perspective_taking",
        "consent_non_coercion",
        "stewardship_non_domination",
        "option_stewardship",
        "human_standing_governance",
        "pluralism_worldview_integrity",
        "attention_wireheading_resistance",
        "long_horizon_consistency"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "FailureGates": {
      "additionalProperties": false,
      "properties": {
        "covert_persuasion": {
          "default": false,
          "title": "Covert Persuasion",
          "type": "boolean"
        },
        "exclusivity_language": {
          "default": false,
          "title": "Exclusivity Language",
          "type": "boolean"
        },
        "human_veto_bypass": {
          "default": false,
          "title": "Human Veto Bypass",
          "type": "boolean"
        },
        "practical_domination": {
          "default": false,
          "title": "Practical Domination",
          "type": "boolean"
        },
        "severe_reality_distortion": {
          "default": false,
          "title": "Severe Reality Distortion",
          "type": "boolean"
        }
      },
      "title": "FailureGates",
      "type": "object"
    },
    "PairedPolicyDelta": {
      "additionalProperties": false,
      "description": "A within-scenario/seed contrast; positive means policy_a scored higher.",
      "properties": {
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "mean_delta": {
          "title": "Mean Delta",
          "type": "number"
        },
        "pair_count": {
          "title": "Pair Count",
          "type": "integer"
        },
        "policy_a": {
          "title": "Policy A",
          "type": "string"
        },
        "policy_b": {
          "title": "Policy B",
          "type": "string"
        }
      },
      "required": [
        "policy_a",
        "policy_b",
        "dimension",
        "mean_delta",
        "pair_count"
      ],
      "title": "PairedPolicyDelta",
      "type": "object"
    },
    "PolicyScoreProfile": {
      "additionalProperties": false,
      "description": "One policy/lens estimand, clustered at the scenario level.",
      "properties": {
        "cluster_bootstrap_95_pct": {
          "additionalProperties": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Cluster Bootstrap 95 Pct",
          "type": "object"
        },
        "formation_profile": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Formation Profile",
          "type": "object"
        },
        "missing_scores": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Missing Scores",
          "type": "object"
        },
        "observation_count": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Observation Count",
          "type": "object"
        },
        "research_control": {
          "default": false,
          "title": "Research Control",
          "type": "boolean"
        },
        "scenario_cluster_count": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Scenario Cluster Count",
          "type": "object"
        }
      },
      "required": [
        "formation_profile",
        "cluster_bootstrap_95_pct",
        "scenario_cluster_count",
        "observation_count",
        "missing_scores"
      ],
      "title": "PolicyScoreProfile",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/score-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance": {
      "title": "Assurance",
      "type": "string"
    },
    "assurance_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Assurance Reasons",
      "type": "array"
    },
    "bootstrap_95_pct": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Bootstrap 95 Pct"
    },
    "configured_judges": {
      "items": {
        "type": "string"
      },
      "title": "Configured Judges",
      "type": "array"
    },
    "failure_gates": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureGates"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_gates_by_policy": {
      "additionalProperties": {
        "$ref": "#/$defs/FailureGates"
      },
      "title": "Failure Gates By Policy",
      "type": "object"
    },
    "formation_profile": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Formation Profile"
    },
    "invariants": {
      "items": {
        "type": "string"
      },
      "title": "Invariants",
      "type": "array"
    },
    "judge_agreement": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Judge Agreement",
      "type": "object"
    },
    "missing_scores": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/Dimension"
      },
      "title": "Missing Scores",
      "type": "object"
    },
    "normative_disagreements": {
      "items": {
        "type": "string"
      },
      "title": "Normative Disagreements",
      "type": "array"
    },
    "observed_judges": {
      "items": {
        "type": "string"
      },
      "title": "Observed Judges",
      "type": "array"
    },
    "paired_policy_deltas": {
      "items": {
        "$ref": "#/$defs/PairedPolicyDelta"
      },
      "title": "Paired Policy Deltas",
      "type": "array"
    },
    "policy_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/PolicyScoreProfile"
      },
      "title": "Policy Profiles",
      "type": "object"
    },
    "sample_count": {
      "title": "Sample Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "formation_profile",
    "bootstrap_95_pct",
    "failure_gates",
    "judge_agreement",
    "sample_count",
    "missing_scores",
    "assurance"
  ],
  "title": "ScoreReport",
  "type": "object"
}
