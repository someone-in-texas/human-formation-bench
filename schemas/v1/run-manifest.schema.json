{
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/run-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget_usd": {
      "title": "Budget Usd",
      "type": "number"
    },
    "completed_sample_ids": {
      "items": {
        "type": "string"
      },
      "title": "Completed Sample Ids",
      "type": "array"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "failed_sample_ids": {
      "items": {
        "type": "string"
      },
      "title": "Failed Sample Ids",
      "type": "array"
    },
    "git_commit": {
      "title": "Git Commit",
      "type": "string"
    },
    "hard_stop": {
      "title": "Hard Stop",
      "type": "boolean"
    },
    "judge_models": {
      "items": {
        "type": "string"
      },
      "title": "Judge Models",
      "type": "array"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "operating_system": {
      "title": "Operating System",
      "type": "string"
    },
    "package_version": {
      "title": "Package Version",
      "type": "string"
    },
    "policies": {
      "items": {
        "type": "string"
      },
      "title": "Policies",
      "type": "array"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "redacted_environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Redacted Environment",
      "type": "object"
    },
    "reserve_fraction": {
      "title": "Reserve Fraction",
      "type": "number"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_pack_hash": {
      "title": "Scenario Pack Hash",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "array"
    },
    "shard_index": {
      "default": 0,
      "title": "Shard Index",
      "type": "integer"
    },
    "shards": {
      "default": 1,
      "title": "Shards",
      "type": "integer"
    },
    "spent_usd": {
      "default": 0,
      "title": "Spent Usd",
      "type": "number"
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "interrupted",
        "completed",
        "failed",
        "budget_exhausted"
      ],
      "title": "Status",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "status",
    "created_at",
    "updated_at",
    "profile",
    "model",
    "judge_models",
    "policies",
    "seeds",
    "scenario_pack_hash",
    "config_hash",
    "git_commit",
    "package_version",
    "python_version",
    "operating_system",
    "budget_usd",
    "hard_stop",
    "reserve_fraction"
  ],
  "title": "RunManifest",
  "type": "object"
}
