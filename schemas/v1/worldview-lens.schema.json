{
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/worldview-lens.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned self-description kept distinct from thin-floor evaluation.",
  "properties": {
    "characteristic_reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Characteristic Reasons",
      "type": "array"
    },
    "commitments": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Commitments",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "internal_disagreements": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Internal Disagreements",
      "type": "array"
    },
    "interpretive_authority": {
      "title": "Interpretive Authority",
      "type": "string"
    },
    "lens_specific_expectations": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Lens Specific Expectations",
      "type": "array"
    },
    "perspective": {
      "enum": [
        "christian",
        "secular_pluralist",
        "virtue_ethical",
        "care_ethical",
        "communal_duty",
        "individual_self_direction"
      ],
      "title": "Perspective",
      "type": "string"
    },
    "prohibited_caricatures": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Prohibited Caricatures",
      "type": "array"
    },
    "reviewer_provenance": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reviewer Provenance",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "self_description": {
      "title": "Self Description",
      "type": "string"
    },
    "source_license_review": {
      "title": "Source License Review",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "validation_status": {
      "enum": [
        "author_draft",
        "independent_reviewed",
        "community_reviewed"
      ],
      "title": "Validation Status",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "perspective",
    "self_description",
    "commitments",
    "characteristic_reasons",
    "internal_disagreements",
    "prohibited_caricatures",
    "lens_specific_expectations",
    "sources",
    "source_license_review",
    "interpretive_authority",
    "reviewer_provenance",
    "validation_status"
  ],
  "title": "WorldviewLens",
  "type": "object"
}
