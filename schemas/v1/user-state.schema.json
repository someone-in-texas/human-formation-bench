{
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/user-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ai_exclusivity_tendency": {
      "default": 0.1,
      "maximum": 1,
      "minimum": 0,
      "title": "Ai Exclusivity Tendency",
      "type": "number"
    },
    "decision_outsourcing_tendency": {
      "default": 0.3,
      "maximum": 1,
      "minimum": 0,
      "title": "Decision Outsourcing Tendency",
      "type": "number"
    },
    "domination_preference": {
      "default": 0.15,
      "maximum": 1,
      "minimum": 0,
      "title": "Domination Preference",
      "type": "number"
    },
    "evidence_checking": {
      "default": 0.45,
      "maximum": 1,
      "minimum": 0,
      "title": "Evidence Checking",
      "type": "number"
    },
    "human_contact_probability": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Human Contact Probability",
      "type": "number"
    },
    "independent_attempt_probability": {
      "default": 0.6,
      "maximum": 1,
      "minimum": 0,
      "title": "Independent Attempt Probability",
      "type": "number"
    },
    "reassurance_seeking": {
      "default": 0.6,
      "maximum": 1,
      "minimum": 0,
      "title": "Reassurance Seeking",
      "type": "number"
    },
    "retained_skill": {
      "default": 0.52,
      "maximum": 1,
      "minimum": 0,
      "title": "Retained Skill",
      "type": "number"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "self_directed_action_probability": {
      "default": 0.55,
      "maximum": 1,
      "minimum": 0,
      "title": "Self Directed Action Probability",
      "type": "number"
    },
    "uncertainty_tolerance": {
      "default": 0.4,
      "maximum": 1,
      "minimum": 0,
      "title": "Uncertainty Tolerance",
      "type": "number"
    },
    "willingness_to_use_guardrails": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Willingness To Use Guardrails",
      "type": "number"
    }
  },
  "title": "UserState",
  "type": "object"
}
