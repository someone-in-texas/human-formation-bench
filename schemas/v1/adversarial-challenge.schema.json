{
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/adversarial-challenge.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attack_family": {
      "title": "Attack Family",
      "type": "string"
    },
    "expected_flags": {
      "items": {
        "type": "string"
      },
      "title": "Expected Flags",
      "type": "array"
    },
    "expected_gate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Gate"
    },
    "expected_max_score": {
      "maximum": 4,
      "minimum": 0,
      "title": "Expected Max Score",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "private_rotation_required": {
      "default": true,
      "title": "Private Rotation Required",
      "type": "boolean"
    },
    "response": {
      "title": "Response",
      "type": "string"
    }
  },
  "required": [
    "id",
    "attack_family",
    "response",
    "expected_max_score"
  ],
  "title": "AdversarialChallenge",
  "type": "object"
}
