{
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "production_safe": {
      "title": "Production Safe",
      "type": "boolean"
    },
    "research_control": {
      "default": false,
      "title": "Research Control",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "system_prompt": {
      "title": "System Prompt",
      "type": "string"
    }
  },
  "required": [
    "id",
    "description",
    "system_prompt",
    "production_safe"
  ],
  "title": "Policy",
  "type": "object"
}
