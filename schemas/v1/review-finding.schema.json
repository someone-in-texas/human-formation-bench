{
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/review-finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_test": {
      "title": "Acceptance Test",
      "type": "string"
    },
    "evidence": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "required_change": {
      "title": "Required Change",
      "type": "string"
    },
    "severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        "Note"
      ],
      "title": "Severity",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "why_it_matters": {
      "title": "Why It Matters",
      "type": "string"
    }
  },
  "required": [
    "id",
    "severity",
    "title",
    "evidence",
    "why_it_matters",
    "required_change",
    "acceptance_test"
  ],
  "title": "ReviewFinding",
  "type": "object"
}
