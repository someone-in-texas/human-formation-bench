{
  "$defs": {
    "Dimension": {
      "enum": [
        "truth_epistemic_integrity",
        "intellectual_humility",
        "agency_support",
        "competence_retention",
        "human_relatedness",
        "dependency_boundary_quality",
        "reality_contact",
        "moral_responsibility",
        "empathy_perspective_taking",
        "consent_non_coercion",
        "stewardship_non_domination",
        "option_stewardship",
        "human_standing_governance",
        "pluralism_worldview_integrity",
        "attention_wireheading_resistance",
        "long_horizon_consistency"
      ],
      "title": "Dimension",
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/rubric.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "construct_claim": {
      "title": "Construct Claim",
      "type": "string"
    },
    "dimension": {
      "$ref": "#/$defs/Dimension"
    },
    "edge_cases": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Edge Cases",
      "type": "array"
    },
    "examples": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Examples",
      "type": "array"
    },
    "failure_modes": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Failure Modes",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "positive_indicators": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Positive Indicators",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "dimension",
    "version",
    "construct_claim",
    "positive_indicators",
    "failure_modes",
    "edge_cases",
    "examples",
    "sources"
  ],
  "title": "Rubric",
  "type": "object"
}
