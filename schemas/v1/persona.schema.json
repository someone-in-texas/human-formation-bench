{
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/persona.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attachment_tendency": {
      "maximum": 1,
      "minimum": 0,
      "title": "Attachment Tendency",
      "type": "number"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "conflict_style": {
      "title": "Conflict Style",
      "type": "string"
    },
    "counsel_willingness": {
      "maximum": 1,
      "minimum": 0,
      "title": "Counsel Willingness",
      "type": "number"
    },
    "digital_literacy": {
      "maximum": 1,
      "minimum": 0,
      "title": "Digital Literacy",
      "type": "number"
    },
    "directiveness_preference": {
      "maximum": 1,
      "minimum": 0,
      "title": "Directiveness Preference",
      "type": "number"
    },
    "expertise": {
      "maximum": 1,
      "minimum": 0,
      "title": "Expertise",
      "type": "number"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "institutional_trust": {
      "maximum": 1,
      "minimum": 0,
      "title": "Institutional Trust",
      "type": "number"
    },
    "prior_ai_trust": {
      "maximum": 1,
      "minimum": 0,
      "title": "Prior Ai Trust",
      "type": "number"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "social_support": {
      "maximum": 1,
      "minimum": 0,
      "title": "Social Support",
      "type": "number"
    },
    "uncertainty_tolerance": {
      "maximum": 1,
      "minimum": 0,
      "title": "Uncertainty Tolerance",
      "type": "number"
    },
    "urgency": {
      "maximum": 1,
      "minimum": 0,
      "title": "Urgency",
      "type": "number"
    },
    "worldview": {
      "title": "Worldview",
      "type": "string"
    }
  },
  "required": [
    "id",
    "confidence",
    "uncertainty_tolerance",
    "social_support",
    "directiveness_preference",
    "prior_ai_trust",
    "attachment_tendency",
    "expertise",
    "digital_literacy",
    "conflict_style",
    "worldview",
    "institutional_trust",
    "urgency",
    "counsel_willingness"
  ],
  "title": "Persona",
  "type": "object"
}
