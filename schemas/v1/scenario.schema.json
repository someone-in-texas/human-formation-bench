{
  "$defs": {
    "Dimension": {
      "enum": [
        "truth_epistemic_integrity",
        "intellectual_humility",
        "agency_support",
        "competence_retention",
        "human_relatedness",
        "dependency_boundary_quality",
        "reality_contact",
        "moral_responsibility",
        "empathy_perspective_taking",
        "consent_non_coercion",
        "stewardship_non_domination",
        "option_stewardship",
        "human_standing_governance",
        "pluralism_worldview_integrity",
        "attention_wireheading_resistance",
        "long_horizon_consistency"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "TrajectoryLength": {
      "enum": [
        "single_turn",
        "short",
        "medium",
        "longitudinal"
      ],
      "title": "TrajectoryLength",
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_parties": {
      "items": {
        "type": "string"
      },
      "title": "Affected Parties",
      "type": "array"
    },
    "approved_for_public_core": {
      "default": false,
      "title": "Approved For Public Core",
      "type": "boolean"
    },
    "consent_structure": {
      "title": "Consent Structure",
      "type": "string"
    },
    "control_label": {
      "anyOf": [
        {
          "enum": [
            "positive",
            "negative",
            "ambiguous",
            "adversarial"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Control Label"
    },
    "dependency_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Dependency Risk",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/Dimension"
      },
      "minItems": 1,
      "title": "Dimensions",
      "type": "array"
    },
    "domain": {
      "title": "Domain",
      "type": "string"
    },
    "failure_modes": {
      "items": {
        "type": "string"
      },
      "title": "Failure Modes",
      "type": "array"
    },
    "follow_ups": {
      "items": {
        "type": "string"
      },
      "title": "Follow Ups",
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "persuasion_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Persuasion Risk",
      "type": "string"
    },
    "positive_indicators": {
      "items": {
        "type": "string"
      },
      "title": "Positive Indicators",
      "type": "array"
    },
    "prohibited_shortcuts": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Shortcuts",
      "type": "array"
    },
    "required_expertise": {
      "items": {
        "type": "string"
      },
      "title": "Required Expertise",
      "type": "array"
    },
    "reversibility": {
      "enum": [
        "high",
        "medium",
        "low",
        "irreversible"
      ],
      "title": "Reversibility",
      "type": "string"
    },
    "scenario_version": {
      "default": "1.0.0",
      "title": "Scenario Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "social_context": {
      "title": "Social Context",
      "type": "string"
    },
    "source_provenance": {
      "items": {
        "type": "string"
      },
      "title": "Source Provenance",
      "type": "array"
    },
    "stakes": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Stakes",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 3,
      "title": "Title",
      "type": "string"
    },
    "trajectory_length": {
      "$ref": "#/$defs/TrajectoryLength"
    },
    "uncertainty": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Uncertainty",
      "type": "string"
    },
    "user_opening": {
      "maxLength": 10000,
      "minLength": 10,
      "title": "User Opening",
      "type": "string"
    },
    "vulnerability": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Vulnerability",
      "type": "string"
    },
    "worldview_salience": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Worldview Salience",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "domain",
    "stakes",
    "reversibility",
    "vulnerability",
    "consent_structure",
    "uncertainty",
    "social_context",
    "worldview_salience",
    "dependency_risk",
    "persuasion_risk",
    "trajectory_length",
    "dimensions",
    "user_opening"
  ],
  "title": "Scenario",
  "type": "object"
}
