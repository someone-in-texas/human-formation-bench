{
  "$defs": {
    "Dimension": {
      "enum": [
        "truth_epistemic_integrity",
        "intellectual_humility",
        "agency_support",
        "competence_retention",
        "human_relatedness",
        "dependency_boundary_quality",
        "reality_contact",
        "moral_responsibility",
        "empathy_perspective_taking",
        "consent_non_coercion",
        "stewardship_non_domination",
        "option_stewardship",
        "human_standing_governance",
        "pluralism_worldview_integrity",
        "attention_wireheading_resistance",
        "long_horizon_consistency"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "message_index": {
          "minimum": 0,
          "title": "Message Index",
          "type": "integer"
        },
        "quote": {
          "maxLength": 280,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "message_index",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "FailureGates": {
      "additionalProperties": false,
      "properties": {
        "covert_persuasion": {
          "default": false,
          "title": "Covert Persuasion",
          "type": "boolean"
        },
        "exclusivity_language": {
          "default": false,
          "title": "Exclusivity Language",
          "type": "boolean"
        },
        "human_veto_bypass": {
          "default": false,
          "title": "Human Veto Bypass",
          "type": "boolean"
        },
        "practical_domination": {
          "default": false,
          "title": "Practical Domination",
          "type": "boolean"
        },
        "severe_reality_distortion": {
          "default": false,
          "title": "Severe Reality Distortion",
          "type": "boolean"
        }
      },
      "title": "FailureGates",
      "type": "object"
    },
    "JudgeResult": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Evidence",
          "type": "array"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "insufficient_evidence": {
          "default": false,
          "title": "Insufficient Evidence",
          "type": "boolean"
        },
        "judge_id": {
          "default": "deterministic-v1",
          "title": "Judge Id",
          "type": "string"
        },
        "not_applicable": {
          "default": false,
          "title": "Not Applicable",
          "type": "boolean"
        },
        "rationale": {
          "maxLength": 2000,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "dimension",
        "confidence",
        "rationale"
      ],
      "title": "JudgeResult",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "Message",
      "type": "object"
    },
    "UserState": {
      "additionalProperties": false,
      "properties": {
        "ai_exclusivity_tendency": {
          "default": 0.1,
          "maximum": 1,
          "minimum": 0,
          "title": "Ai Exclusivity Tendency",
          "type": "number"
        },
        "decision_outsourcing_tendency": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Decision Outsourcing Tendency",
          "type": "number"
        },
        "domination_preference": {
          "default": 0.15,
          "maximum": 1,
          "minimum": 0,
          "title": "Domination Preference",
          "type": "number"
        },
        "evidence_checking": {
          "default": 0.45,
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Checking",
          "type": "number"
        },
        "human_contact_probability": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Human Contact Probability",
          "type": "number"
        },
        "independent_attempt_probability": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Independent Attempt Probability",
          "type": "number"
        },
        "reassurance_seeking": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Reassurance Seeking",
          "type": "number"
        },
        "retained_skill": {
          "default": 0.52,
          "maximum": 1,
          "minimum": 0,
          "title": "Retained Skill",
          "type": "number"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "self_directed_action_probability": {
          "default": 0.55,
          "maximum": 1,
          "minimum": 0,
          "title": "Self Directed Action Probability",
          "type": "number"
        },
        "uncertainty_tolerance": {
          "default": 0.4,
          "maximum": 1,
          "minimum": 0,
          "title": "Uncertainty Tolerance",
          "type": "number"
        },
        "willingness_to_use_guardrails": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Willingness To Use Guardrails",
          "type": "number"
        }
      },
      "title": "UserState",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/trajectory.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cost_usd": {
      "minimum": 0,
      "title": "Cost Usd",
      "type": "number"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "failure_gates": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureGates"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "final_state": {
      "$ref": "#/$defs/UserState"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "initial_state": {
      "$ref": "#/$defs/UserState"
    },
    "judge_results": {
      "items": {
        "$ref": "#/$defs/JudgeResult"
      },
      "title": "Judge Results",
      "type": "array"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/Message"
      },
      "title": "Messages",
      "type": "array"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "state_evidence_status": {
      "const": "scorer_derived_diagnostic_not_outcome",
      "default": "scorer_derived_diagnostic_not_outcome",
      "title": "State Evidence Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "scenario_id",
    "policy_id",
    "model_id",
    "seed",
    "messages",
    "initial_state",
    "final_state",
    "judge_results",
    "cost_usd",
    "latency_ms"
  ],
  "title": "Trajectory",
  "type": "object"
}
