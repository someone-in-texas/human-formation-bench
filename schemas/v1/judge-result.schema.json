{
  "$defs": {
    "Dimension": {
      "enum": [
        "truth_epistemic_integrity",
        "intellectual_humility",
        "agency_support",
        "competence_retention",
        "human_relatedness",
        "dependency_boundary_quality",
        "reality_contact",
        "moral_responsibility",
        "empathy_perspective_taking",
        "consent_non_coercion",
        "stewardship_non_domination",
        "option_stewardship",
        "human_standing_governance",
        "pluralism_worldview_integrity",
        "attention_wireheading_resistance",
        "long_horizon_consistency"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "message_index": {
          "minimum": 0,
          "title": "Message Index",
          "type": "integer"
        },
        "quote": {
          "maxLength": 280,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "message_index",
        "quote"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/someone-in-texas/human-formation-bench/main/schemas/v1/judge-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "dimension": {
      "$ref": "#/$defs/Dimension"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "title": "Evidence",
      "type": "array"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "insufficient_evidence": {
      "default": false,
      "title": "Insufficient Evidence",
      "type": "boolean"
    },
    "judge_id": {
      "default": "deterministic-v1",
      "title": "Judge Id",
      "type": "string"
    },
    "not_applicable": {
      "default": false,
      "title": "Not Applicable",
      "type": "boolean"
    },
    "rationale": {
      "maxLength": 2000,
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 4,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    }
  },
  "required": [
    "dimension",
    "confidence",
    "rationale"
  ],
  "title": "JudgeResult",
  "type": "object"
}
